{
  "name": "@oai404iao/pi-codex-core",
  "version": "1.0.0",
  "private": false,
  "description": "Unpublished pi-codex-core workspace for the staged Codex split",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oai404iao/omp.git",
    "directory": "pi-extensions/pi-codex-core"
  },
  "homepage": "https://github.com/oai404iao/omp/tree/main/pi-extensions/pi-codex-core#readme",
  "bugs": {
    "url": "https://github.com/oai404iao/omp/issues"
  },
  "keywords": [
    "pi-package",
    "codex"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./internal/*": "./src/*.ts"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.99.1",
    "@earendil-works/pi-coding-agent": ">=0.99.1",
    "@earendil-works/pi-tui": ">=0.99.1",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "dependencies": {
    "https-proxy-agent": "^9.1.0",
    "socks-proxy-agent": "^10.1.0",
    "undici": "^8.10.0",
    "ws": "^8.21.1",
    "@oai404iao/pi-codex-runtime": "1.0.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.0.4",
    "@earendil-works/pi-coding-agent": "1.0.4",
    "@earendil-works/pi-tui": "1.0.4",
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typebox": "^1.3.36",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "check": "pnpm run typecheck && pnpm run test"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "index.ts",
    "src/",
    "LICENSE",
    "LICENSES/",
    "THIRD_PARTY_NOTICES.md",
    "provenance/",
    "README.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  }
