{
  "name": "@oai404iao/pi-telegram-notify",
  "version": "0.4.0",
  "description": "Send Telegram notifications when Pi completes, stops on an error, or opens a blocking extension UI prompt.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oai404iao/omp.git",
    "directory": "pi-extensions/pi-telegram-notify"
  },
  "homepage": "https://github.com/oai404iao/omp/tree/main/pi-extensions/pi-telegram-notify#readme",
  "bugs": {
    "url": "https://github.com/oai404iao/omp/issues"
  },
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "extension",
    "telegram",
    "notification"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.86.1"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.86.1",
