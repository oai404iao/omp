    "tsx": "^4.20.6",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "check": "npm run typecheck && npm test"
  },
  "files": [
    "index.ts",
    "src/",
    "README.md",
    "LICENSE",
    "config.example.json",
    "config.schema.json",
    "package.json"
  ],
  "engines": {
