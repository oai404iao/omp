    "directory": "pi-extensions/pi-codex-minimal-tools"
  },
  "homepage": "https://github.com/oai404iao/omp/tree/main/pi-extensions/pi-codex-minimal-tools#readme",
  "bugs": {
    "url": "https://github.com/oai404iao/omp/issues"
  },
  "type": "module",
