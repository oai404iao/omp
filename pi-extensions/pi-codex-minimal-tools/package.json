    ".": "./src/index.ts",
    "./subagent-inline": "./src/subagent-inline.ts"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "codex",
    "openai",
    "image-generation",
    "web-search",
    "apply-patch"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "publishConfig": {
