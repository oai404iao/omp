{
  "name": "omp-pi-extensions-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Private release workspace for the OMP Pi extension packages.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oai404iao/omp.git"
  },
  "homepage": "https://github.com/oai404iao/omp#readme",
  "bugs": {
    "url": "https://github.com/oai404iao/omp/issues"
  },
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=22.19.0",
    "npm": ">=11.5.1"
  },
  "workspaces": [
    "pi-extensions/external-thinking",
    "pi-extensions/pi-codex-minimal-tools",
    "pi-extensions/pi-codex-runtime",
    "pi-extensions/pi-codex-core",
    "pi-extensions/pi-codex-web-search",
    "pi-extensions/pi-codex-imagegen",
    "pi-extensions/pi-code-mode",
    "pi-extensions/pi-keep-defaults",
    "pi-extensions/pi-subagent",
    "pi-extensions/pi-telegram-notify",
    "pi-extensions/pi-tree-continue"
  ],
  "scripts": {
    "audit:history": "bash scripts/audit-public-history.sh",
    "changeset": "changeset",
    "changeset:status": "changeset status --verbose",
    "changeset:version": "node scripts/workspace-versioning.mjs version",
    "changeset:sync": "node scripts/workspace-versioning.mjs sync",
    "changeset:check": "node scripts/workspace-versioning.mjs check",
    "check": "npm run check --workspaces --if-present",
    "check:architecture": "node scripts/check-codex-architecture.mjs",
    "test:architecture": "node --test scripts/check-codex-architecture.test.mjs scripts/release-dependencies.test.mjs",
    "ci": "npm run check:pi-baseline && npm run changeset:check && npm run check:architecture && npm run test:architecture && npm run check && npm run test:release-scripts && npm run license:check && npm run pack:check && npm run test:codex-packages",
    "check:pi-baseline": "node scripts/check-pi-baseline.mjs",
    "ci:pi-matrix": "node scripts/test-pi-baselines.mjs",
    "ci:pi-floor": "node scripts/test-pi-baselines.mjs floor",
    "ci:pi-target": "node scripts/test-pi-baselines.mjs target",
    "test:codex-packages": "node scripts/verify-codex-installations.mjs",
    "test:code-mode-s0": "node scripts/code-mode-s0/run.mjs",
    "test:code-mode-package": "node scripts/verify-code-mode-installation.mjs",
    "license:check": "node scripts/verify-licenses.mjs",
    "pack:check": "node scripts/verify-packages.mjs",
    "release:artifacts": "node scripts/prepare-release-artifacts.mjs",
    "release:bootstrap-artifacts": "node scripts/prepare-release-artifacts.mjs --include-bootstrap",
    "release:preflight": "node scripts/release-preflight.mjs",
    "test:release-scripts": "node --test scripts/recovery-guard.test.mjs scripts/release-result.test.mjs scripts/publish-release-artifacts.test.mjs scripts/initial-codex-bootstrap.test.mjs scripts/published-artifact-lock.test.mjs scripts/workspaces.test.mjs scripts/workspace-versioning.test.mjs scripts/isolated-consumer-lock.test.mjs scripts/pi-baselines.test.mjs"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "@changesets/cli": "3.0.0",
    "@changesets/read": "1.0.0",
    "typescript-ast": "npm:typescript@5.9.3"
  }
}
